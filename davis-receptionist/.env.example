# JSON object mapping 10-digit phone numbers to names, e.g. {"8325551212":"Jane Doe"}.
# When a known number calls or texts, owner alerts show the name instead of
# 'unknown'. Keep real customer numbers ONLY here / in the host's env settings —
# never commit them to the repo.
KNOWN_CALLERS=

